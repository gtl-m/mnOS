#!/bin/sh
# mnOS system info card

E=$(printf '\033')
G="${E}[1;32m"; C="${E}[1;36m"; Y="${E}[1;33m"; W="${E}[1;37m"; N="${E}[0m"

kver=$(uname -r)
cores=$(grep -c ^processor /proc/cpuinfo)
model=$(grep 'model name' /proc/cpuinfo | head -1 | cut -d: -f2 | sed 's/^ *//')
[ -z "$model" ] && model="n/a"
mt=$(grep MemTotal /proc/meminfo | tr -dc '0-9')
ma=$(grep -a MemAvailable /proc/meminfo | tr -dc '0-9')
[ -z "$ma" ] && ma=$mt
used=$(( (mt - ma) / 1024 ))
total=$(( mt / 1024 ))
up=$(cut -d' ' -f1 /proc/uptime)
upi=${up%%.*}
if [ "$upi" -ge 3600 ]; then
	uptime_s="$((upi / 3600))h $((upi % 3600 / 60))m"
elif [ "$upi" -ge 60 ]; then
	uptime_s="$((upi / 60))m $((upi % 60))s"
else
	uptime_s="${upi}s"
fi

ipaddr=$(ifconfig eth0 2>/dev/null | awk '/inet /{print $2}' | sed 's/addr://')
[ -z "$ipaddr" ] && ipaddr=$(ifconfig lo 2>/dev/null | awk '/inet /{print $2}' | sed 's/addr://')
[ -z "$ipaddr" ] && ipaddr="none"
disk=$(du -sh / 2>/dev/null | awk '{print $1}')
[ -z "$disk" ] && disk="n/a"

logo1='                  _____   ____       '
logo2='                 /\  __`\/\  _`\     '
logo3='  ___ ___     ___\ \ \/\ \ \,\L\_\   '
logo4="/' __\` __\`\\ /' _ \`\\ \\ \\ \\ \\/\\__ \\   "
logo5='/\ \/\ \/\ \/\ \/\ \ \ \_\ \/\ \L\ \ '
logo6='\ \_\ \_\ \_\ \_\ \_\ \_____\ `\____\'
logo7=' \/_/\/_/\/_/\/_/\/_/\/_____/\/_____/'

pad='                                      '

printf '%b%s%b%b  %bmnOS%b\n' "$C" "$logo1" "$N" "$pad" "$C" "$N"
printf '%b%s%b%b  %b%s%b\n' "$C" "$logo2" "$N" "$pad" "$W" "---------------------------" "$N"
printf '%b%s%b%b  %b%-9s%bmnOS 1.2 (GNU/Linux)\n' "$C" "$logo3" "$N" "$pad" "$Y" "OS:" "$N"
printf '%b%s%b%b  %b%-9s%b%s\n' "$C" "$logo4" "$N" "$pad" "$Y" "Kernel:" "$N" "$kver"
printf '%b%s%b%b  %b%-9s%b%s\n' "$C" "$logo5" "$N" "$pad" "$Y" "Uptime:" "$N" "$uptime_s"
printf '%b%s%b%b  %b%-9s%b%s\n' "$C" "$logo6" "$N" "$pad" "$Y" "Shell:" "$N" "busybox sh"
printf '%b%s%b%b  %b%-9s%b%s (%s)\n' "$C" "$logo7" "$N" "$pad" "$Y" "CPU:" "$N" "$cores" "$model"
printf '%b%s%b%b  %b%-9s%b%sM / %sM\n' "$N" "$pad" "$N" "$pad" "$Y" "Memory:" "$N" "$used" "$total"
printf '%b%s%b%b  %b%-9s%b%s\n' "$N" "$pad" "$N" "$pad" "$Y" "IP:" "$N" "$ipaddr"
printf '%b%s%b%b  %b%-9s%b%s\n' "$N" "$pad" "$N" "$pad" "$Y" "Disk:" "$N" "$disk"
printf '\n'
